# Public gateway; this is also the default when OSRM_URL is absent.
OSRM_URL=https://app.freebus.cloud/routing

# Optional, independently hosted OSRM-compatible service approved for paid rides.
# Leave unset until a production backup with consistent coverage/profile exists.
# ROUTING_FALLBACK_API_BASE_URL=https://your-approved-backup.example/routing

# On the routing VPS, override OSRM_URL with the actual private service URL.
# Its address/port must be supplied by deployment; localhost is not reachable
# across separate servers or isolated container networks.
