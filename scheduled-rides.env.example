# Primary transactional email API; use a verified sender domain.
RESEND_API_KEY=replace-with-your-resend-key
EMAIL_FROM="K-Ride <rides@example.com>"

# Independent SMTP fallback. Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-user
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM="K-Ride <rides@example.com>"

# Default gap after the estimated end of a reserved journey, before the next pickup.
SCHEDULED_RIDE_BUFFER_MINUTES=30
